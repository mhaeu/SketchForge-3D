# Note: the image build (-f deploy/docker/Dockerfile) uses the file next to that
# Dockerfile, deploy/docker/Dockerfile.dockerignore, not this one. Keep both in step.
.git
.github
.codex
.codex-run
.codex-remote-attachments
node_modules
**/node_modules
# next.config.ts writes to .next, .next-dev (dev server) or .next-export.
**/.next*
# Staged from node_modules by the prebuild step, so the image rebuilds it.
apps/web/public/occt
apps/web/out
coverage
playwright-report
test-results
tests
docs
*.log
*.tsbuildinfo
# Exported images (docker save) and other archives dropped into the tree
*.tar
*.tar.gz
*.tgz
